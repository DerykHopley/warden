{
  "name": "@warden/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PGUSER=warden_app node --watch src/index.ts",
    "start": "node src/index.ts",
    "roles": "node src/roles.ts",
    "migrate": "node src/migrate.ts",
    "load-cves": "node src/modules/patch/cve-snapshot.ts",
    "expire": "PGUSER=warden_app node src/daily-expiry.ts",
    "seed": "PGUSER=warden_app node src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:rules": "vitest run --reporter=default test/rules-eval.test.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.32.0",
    "@hono/node-server": "^2.1.11",
    "@renovatebot/pep440": "^6.0.0",
    "@warden/contracts": "workspace:*",
    "hono": "^4.13.21",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "semver": "^7.8.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.7.1",
    "jose": "^6.2.18",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
