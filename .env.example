# Every variable Warden reads, by name only. Locally `.envrc` sets them (secrets from the keyring);
# on Cloud Run they come from the service's configuration and Secret Manager.

# Server, required
CLERK_SECRET_KEY=
PGHOST=
PGUSER=
PGDATABASE=

# Server, optional
# Clerk's PEM public key: verifies session tokens without a network call. Unset, the secret key fetches it.
CLERK_JWT_KEY=
PGPASSWORD=
PGPORT=
# The port to listen on (default 8080; Cloud Run sets it).
PORT=
# The dashboard origins a Clerk session token may be made for, comma-separated. Required on Cloud Run;
# locally it defaults to http://localhost:5173.
CLERK_AUTHORIZED_PARTIES=
# Set by Cloud Run in every container; never set it yourself. Set, the server reads the client address from
# X-Forwarded-For and requires CLERK_AUTHORIZED_PARTIES.
K_SERVICE=
# The built dashboard's folder (default dashboard/dist). Only the browser tests set it, to their own build.
WARDEN_DASHBOARD_DIR=
# The Scan Job on Cloud Run, projects/<project>/locations/<region>/jobs/<job>; a release sets it. Set, "Scan now"
# runs that Job with a token from Google's metadata server. Unset off Cloud Run, the Job runs as a child process of
# the server; unset on Cloud Run (K_SERVICE set, as on an owner preview), none runs and "Scan now" answers 503.
WARDEN_SCAN_JOB=

# Read by the demo seed (`pnpm --filter @warden/server seed`) only: it refuses to start without it. Any value
# locally; on a hosted database, that database's name (never the live one).
WARDEN_SEED_DEMO=

# Dashboard build, and the server (the CSP allows the Clerk host this key names). Public by design.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional, read by `pnpm roles`: set, each becomes that role's password (Cloud SQL). Empty locally: compose uses trust auth.
WARDEN_APP_PASSWORD=
WARDEN_MIGRATE_PASSWORD=
# Also read by the daily Job (`pnpm --filter @warden/server expire`), as warden_admin's password to list the Teams.
# Required there whenever PGPASSWORD is set: the Job never sends the app's password as the admin's.
WARDEN_ADMIN_PASSWORD=

# GitHub repository variables (not secrets, and not set locally), which `scripts/gcp-setup.sh` sets. The owner
# preview workflow (`.github/workflows/preview.yml`) and the release and rollback workflows (`release.yml`,
# `rollback.yml`) read these, with VITE_CLERK_PUBLISHABLE_KEY above, and pass them to `scripts/cloud-run-deploy.sh`
# or `scripts/cloud-run-rollback.sh`. Without GCP_PROJECT_ID or GCP_PREVIEW_DEPLOY_SA a preview deploys nothing;
# without GCP_PROJECT_ID or GCP_DEPLOY_SA a release or rollback deploys nothing.
GCP_PROJECT_ID=
GCP_WIF_PROVIDER=
GCP_PREVIEW_DEPLOY_SA=
# warden-deploy's email: the account main's release and rollback act as.
GCP_DEPLOY_SA=
# <project>:<region>:<instance>
CLOUD_SQL_CONNECTION=