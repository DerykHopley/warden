# Loaded by direnv (`direnv allow`). Secrets come from the system keyring, never from a file in the repo.
export CLERK_SECRET_KEY=$(secret-tool lookup service warden-clerk-secret)
export VITE_CLERK_PUBLISHABLE_KEY=$(secret-tool lookup service warden-clerk-publishable)
export CLERK_JWT_KEY=$(secret-tool lookup service warden-clerk-jwt-key)

# The compose file's Postgres: not secrets (trust auth, bound to 127.0.0.1).
export PGHOST=127.0.0.1
export PGPORT=54329
export PGUSER=warden
export PGDATABASE=warden
export GITHUB_APP_CLIENT_ID="$(secret-tool lookup service warden-github-app-client-id)"
export GITHUB_APP_CLIENT_SECRET="$(secret-tool lookup service warden-github-app-client-secret)"
export GITHUB_APP_PRIVATE_KEY="$(secret-tool lookup service warden-github-app-private-key)"
# The write GitHub app Fix PRs go through: all three or none.
export GITHUB_WRITE_APP_CLIENT_ID="$(secret-tool lookup service warden-github-write-app-client-id)"
export GITHUB_WRITE_APP_CLIENT_SECRET="$(secret-tool lookup service warden-github-write-app-client-secret)"
export GITHUB_WRITE_APP_PRIVATE_KEY="$(secret-tool lookup service warden-github-write-app-private-key)"
# The hook's pseudonym key (optional, #185): with no keyring entry it's empty, which loadConfig reads as unset, so the server starts and only the hook endpoint answers 503.
export WARDEN_PSEUDONYM_KEY="$(secret-tool lookup service warden-pseudonym-key)"
export OPENROUTER_API_KEY=$(secret-tool lookup service warden-openrouter-api-key)
# A Team's own Judge model may be on localhost here (local development only).
export WARDEN_JUDGE_LOCALHOST=1
